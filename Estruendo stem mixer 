name: Build Android APK

on:
  workflow_dispatch:
  push:
    branches: [ main ]
    paths:
      - '*.zip'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Preparar proyecto (descomprime el ZIP si existe)
        run: |
          set -e
          ZIP=$(ls -t *.zip 2>/dev/null | head -n 1 || true)
          if [ -n "$ZIP" ]; then
            echo "Usando ZIP: $ZIP"
            rm -rf _src && mkdir _src
            unzip -q -o "$ZIP" -d _src
            SEARCH=_src
          else
            echo "No hay ZIP; usando archivos del repositorio"
            SEARCH=.
          fi
          SETTINGS=$(find "$SEARCH" -name settings.gradle.kts -not -path '*/.git/*' -not -path '*/__MACOSX/*' | head -n 1)
          if [ -z "$SETTINGS" ]; then
            echo "::error::No se encontró settings.gradle.kts. Sube el ZIP completo a la raíz del repositorio."
            exit 1
          fi
          PROJECT_DIR=$(dirname "$SETTINGS")
          if [ ! -f "$PROJECT_DIR/app/build.gradle.kts" ]; then
            echo "::error::Falta app/build.gradle.kts dentro de $PROJECT_DIR"
            exit 1
          fi
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo "Proyecto en: $PROJECT_DIR"
          find "$PROJECT_DIR" -type f -not -path '*/.git/*' | sort

      - name: Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Android SDK
        uses: android-actions/setup-android@v3

      - name: Instalar paquetes del SDK
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'

      - name: Compilar APK debug
        run: |
          cd "$PROJECT_DIR"
          gradle assembleDebug --stacktrace

      - name: Subir APK
        uses: actions/upload-artifact@v4
        with:
          name: ESTRUENDO-STEM-MIXER-debug
          path: ${{ env.PROJECT_DIR }}/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error